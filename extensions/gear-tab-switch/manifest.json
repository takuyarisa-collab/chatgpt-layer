{
  "manifest_version": 3,
  "name": "ChatGPT Layer Tab Switch for Gear",
  "version": "0.8.0",
  "description": "Adds a left-side button that switches to the next already-open ChatGPT tab in Gear Browser.",
  "key": "",
  "permissions": ["tabs", "storage"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
