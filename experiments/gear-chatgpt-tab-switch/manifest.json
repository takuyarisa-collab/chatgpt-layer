{
  "manifest_version": 3,
  "name": "ChatGPT Tab Switch Test for Gear",
  "version": "0.1.0",
  "description": "Adds a button that switches to the next open ChatGPT tab in Gear Browser.",
  "permissions": [
    "tabs"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
